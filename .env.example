# Copy to .env (git-ignored) and fill in. Used only by docker-compose.yml; see docs/docker.md.
# Never commit .env.

# Required. SQL Server sa password: at least 8 characters with upper, lower, digit and symbol.
# Use only letters, digits and - _ ! . @ (no ; " ' $ # or spaces): it is placed in a
# connection string and the value is read by Compose interpolation.
MSSQL_SA_PASSWORD=

# Optional. HMAC key for unique-visitor analytics, at least 32 characters. Leave empty to
# disable unique-visitor counts.
ANALYTICS_VISITOR_HASH_SECRET=

# Optional. Host port for the API (bound to 127.0.0.1). Default 8080.
API_HOST_PORT=8080

# Optional. Public origin used to build short URLs. Default http://localhost:<API_HOST_PORT>.
# PUBLIC_BASE_URL=http://localhost:8080

# Optional. Production (default) or Development (enables Swagger at /swagger).
# ASPNETCORE_ENVIRONMENT=Production
