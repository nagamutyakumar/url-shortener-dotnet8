{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Analytics": {
    "QueueCapacity": 10000,
    "BatchSize": 100
  },
  "RedirectCache": {
    "MaxTimeToLive": "00:05:00"
  },
  "RateLimiting": {
    "Mutations": {
      "PermitLimit": 20,
      "Window": "00:01:00",
      "QueueLimit": 0
    },
    "Analytics": {
      "PermitLimit": 60,
      "Window": "00:01:00",
      "QueueLimit": 0
    }
  }
}
